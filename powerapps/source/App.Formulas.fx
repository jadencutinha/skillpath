// Training Portal: named formulas. Paste the whole file into App.Formulas.
// Generated by powerapps/source/generate.py. Named formulas are evaluated lazily and
// cached, so nothing here slows down app start.

// ── Who is signed in ──────────────────────────────────────────────
// Matched on the Entra object ID. Matching on email breaks when a user's sign-in
// name and primary email differ.
fxMe = LookUp(Users, 'Azure AD Object ID' = User().EntraObjectId);

// Shows the Approvals screen. UX only: Dataverse security roles decide who can read
// which rows. Sees roles assigned directly to the user, not through a team.
fxIsManager =
    !IsEmpty(
        Filter(
            fxMe.'Security Roles (systemuserroles_association)',
            Name in ["Training Manager", "Training Admin", "System Administrator"]
        )
    );

fxInitials =
    Upper(
        Left(User().FullName, 1)
            & Mid(User().FullName, Find(" ", User().FullName & " ") + 1, 1)
    );

// ── Choice values ────────────────────────────────────────────────
// Every screen goes through these two records. If Studio's IntelliSense shows a
// different enum name for your choice columns, this is the only place to change it.
fxStatus = {
    Draft:     'Request Status (Training Requests)'.Draft,
    Submitted: 'Request Status (Training Requests)'.Submitted,
    Approved:  'Request Status (Training Requests)'.Approved,
    Completed: 'Request Status (Training Requests)'.Completed,
    Rejected:  'Request Status (Training Requests)'.Rejected,
    Expired:   'Request Status (Training Requests)'.Expired,
    Withdrawn: 'Request Status (Training Requests)'.Withdrawn,
    Error:     'Request Status (Training Requests)'.Error
};

fxAction = {
    Submit:   'Requested Action (Training Requests)'.Submit,
    Withdraw: 'Requested Action (Training Requests)'.Withdraw,
    Complete: 'Requested Action (Training Requests)'.Complete
};

// Used only while the estimate API is unreachable. The API's high_cost_threshold is the
// source of truth; see "The $1,000 threshold" in dataverse/schema.md.
fxFallbackThreshold = 1000;

// ── Numbers on the home screen ───────────────────────────────────
fxKpiInReview = CountRows(Filter('Training Requests', Owner = fxMe, 'Request Status' = fxStatus.Submitted));
fxKpiApproved = CountRows(Filter('Training Requests', Owner = fxMe, 'Request Status' = fxStatus.Approved || 'Request Status' = fxStatus.Completed));
fxKpiDrafts = CountRows(Filter('Training Requests', Owner = fxMe, 'Request Status' = fxStatus.Draft));
fxKpiSpend = Sum(Filter('Training Requests', Owner = fxMe, 'Request Status' = fxStatus.Approved || 'Request Status' = fxStatus.Completed), 'Course Cost');

// Badge on the Approvals nav item: approvals assigned to me right now.
fxPendingCount =
    CountRows(
        Filter(
            'Training Requests',
            'Request Status' = fxStatus.Submitted,
            'Pending With' = fxMe.'Primary Email'
        )
    );

// ── Theme ────────────────────────────────────────────────────────
// One palette for the whole app. fxHex holds the values (the inline SVG icons need
// hex text); fxTheme is the same palette as colours for control properties.
fxHex = {
    Navy:           "#0B1F3A",
    NavyLift:       "#16305A",
    NavText:        "#B9C6DB",
    Canvas:         "#F4F6FA",
    Surface:        "#FFFFFF",
    SurfaceAlt:     "#F8FAFC",
    Border:         "#E3E8EF",
    Ink:            "#0F1B2D",
    Body:           "#344054",
    Muted:          "#5B6B82",
    Subtle:         "#8A97AB",
    Primary:        "#2457D6",
    PrimaryHover:   "#1D48B5",
    PrimaryPressed: "#173A93",
    PrimaryTint:    "#EAF0FE",
    Danger:         "#B42318",
    DangerTint:     "#FDECEA",
    Warn:           "#B54708",
    WarnTint:       "#FEF0E1",
    Good:           "#15803D",
    GoodTint:       "#E7F6EC",
    White:          "#FFFFFF",
    Disabled:       "#D5DBE5"
};

fxTheme = {
    Navy:           ColorValue(fxHex.Navy),
    NavyLift:       ColorValue(fxHex.NavyLift),
    NavText:        ColorValue(fxHex.NavText),
    Canvas:         ColorValue(fxHex.Canvas),
    Surface:        ColorValue(fxHex.Surface),
    SurfaceAlt:     ColorValue(fxHex.SurfaceAlt),
    Border:         ColorValue(fxHex.Border),
    Ink:            ColorValue(fxHex.Ink),
    Body:           ColorValue(fxHex.Body),
    Muted:          ColorValue(fxHex.Muted),
    Subtle:         ColorValue(fxHex.Subtle),
    Primary:        ColorValue(fxHex.Primary),
    PrimaryHover:   ColorValue(fxHex.PrimaryHover),
    PrimaryPressed: ColorValue(fxHex.PrimaryPressed),
    PrimaryTint:    ColorValue(fxHex.PrimaryTint),
    Danger:         ColorValue(fxHex.Danger),
    DangerTint:     ColorValue(fxHex.DangerTint),
    Warn:           ColorValue(fxHex.Warn),
    WarnTint:       ColorValue(fxHex.WarnTint),
    Good:           ColorValue(fxHex.Good),
    GoodTint:       ColorValue(fxHex.GoodTint),
    White:          ColorValue(fxHex.White),
    Disabled:       ColorValue(fxHex.Disabled)
};

// Colours per request status, plus where the status sits on the four-step tracker
// (Rank) and whether it ended badly (Bad), which turns that step the status colour.
fxStatusStyles = Table(
    { Key: "Draft", Fg: ColorValue("#475467"), Bg: ColorValue("#EEF1F5"), Rank: 1, Bad: false },
    { Key: "Submitted", Fg: ColorValue("#1D4ED8"), Bg: ColorValue("#DCE7FD"), Rank: 2, Bad: false },
    { Key: "Approved", Fg: ColorValue("#15803D"), Bg: ColorValue("#E7F6EC"), Rank: 3, Bad: false },
    { Key: "Completed", Fg: ColorValue("#0F766E"), Bg: ColorValue("#E0F5F2"), Rank: 4, Bad: false },
    { Key: "Rejected", Fg: ColorValue("#B42318"), Bg: ColorValue("#FDECEA"), Rank: 3, Bad: true },
    { Key: "Expired", Fg: ColorValue("#B54708"), Bg: ColorValue("#FEF0E1"), Rank: 3, Bad: true },
    { Key: "Withdrawn", Fg: ColorValue("#475467"), Bg: ColorValue("#EEF1F5"), Rank: 3, Bad: true },
    { Key: "Error", Fg: ColorValue("#912018"), Bg: ColorValue("#FDECEA"), Rank: 3, Bad: true }
);

fxCategoryStyles = Table(
    { Key: "Technical", Fg: ColorValue("#1D4ED8"), Bg: ColorValue("#E8EFFE") },
    { Key: "Leadership", Fg: ColorValue("#7A3EB1"), Bg: ColorValue("#F3EAFB") },
    { Key: "Compliance", Fg: ColorValue("#0F766E"), Bg: ColorValue("#E0F5F2") },
    { Key: "Professional Development", Fg: ColorValue("#B54708"), Bg: ColorValue("#FEF0E1") }
);

// Icon shapes, drawn on a 24 x 24 grid. Each image control wraps one in an <svg> element
// with its own stroke colour, so the app carries no image files.
fxIcon = {
    Home:      "<path d='M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'/>",
    Catalog:   "<path d='M2 5h6a4 4 0 0 1 4 4v11a3 3 0 0 0-3-3H2z'/><path d='M22 5h-6a4 4 0 0 0-4 4v11a3 3 0 0 1 3-3h7z'/>",
    Approvals: "<circle cx='12' cy='12' r='9'/><path d='m8.5 12.5 2.5 2.5 4.5-5'/>",
    Plus:      "<path d='M12 5v14M5 12h14'/>",
    Search:    "<circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/>",
    Refresh:   "<path d='M20 11a8 8 0 1 0-2.3 5.7'/><path d='M20 4v7h-7'/>",
    Back:      "<path d='M19 12H5M11 6l-6 6 6 6'/>",
    User:      "<circle cx='12' cy='8' r='4'/><path d='M4 21a8 8 0 0 1 16 0'/>",
    Cap:       "<path d='M2 9l10-5 10 5-10 5z'/><path d='M6 11.5V16c2 2 10 2 12 0v-4.5'/><path d='M22 9v6'/>"
};
